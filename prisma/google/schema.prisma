// Separate database for Google Ads data (GOOGLE_DATABASE_URL), kept apart from the main
// Meta/CRM database. Generate with: prisma generate --schema prisma/google/schema.prisma
generator client {
  provider = "prisma-client-js"
  output   = "../../lib/generated/google-client"
}

datasource db {
  provider = "postgresql"
  url      = env("GOOGLE_DATABASE_URL")
}

model GoogleCampaign {
  id                  String   @id // Google campaign id
  name                String
  status              String // ENABLED | PAUSED | REMOVED
  channelType         String?
  biddingStrategyType String?
  dailyBudget         Float?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  insights GoogleInsight[]
}

model GoogleInsight {
  id                    String   @id // campaignId_date
  campaignId            String
  date                  DateTime
  spend                 Float    @default(0)
  impressions           Int      @default(0)
  clicks                Int      @default(0)
  ctr                   Float    @default(0)
  cpc                   Float    @default(0)
  cpm                   Float    @default(0)
  conversions           Float    @default(0)
  conversionValue       Float    @default(0)
  costPerConversion     Float?
  allConversions        Float    @default(0)
  interactions          Int      @default(0)
  videoViews            Int      @default(0)
  searchImpressionShare Float?
  searchBudgetLostIS    Float?
  searchRankLostIS      Float?
  searchTopIS           Float?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  campaign GoogleCampaign @relation(fields: [campaignId], references: [id])

  @@index([campaignId, date])
  @@index([date])
}

model GoogleAdGroup {
  id         String   @id
  campaignId String
  name       String
  status     String
  type       String?
  cpcBid     Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([campaignId])
}

model GoogleAd {
  id           String   @id
  adGroupId    String
  campaignId   String
  name         String?
  type         String?
  status       String
  finalUrls    String[]
  headlines    String[]
  descriptions String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([adGroupId])
  @@index([campaignId])
}

model GoogleKeyword {
  id           String   @id // adGroupId~criterionId
  adGroupId    String
  campaignId   String
  text         String
  matchType    String
  status       String
  negative     Boolean  @default(false)
  qualityScore Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([campaignId])
  @@index([adGroupId])
}

// One flat fact table for every breakdown: level = ad_group | ad | keyword | search_term |
// device | network | hour | geo | age | gender | conversion_action
model GoogleStat {
  id              String   @id
  level           String
  date            DateTime
  campaignId      String
  adGroupId       String?
  entityId        String?
  dim1            String?
  dim2            String?
  spend           Float    @default(0)
  impressions     Int      @default(0)
  clicks          Int      @default(0)
  conversions     Float    @default(0)
  conversionValue Float    @default(0)
  allConversions  Float    @default(0)
  interactions    Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([level, date])
  @@index([level, campaignId, date])
}

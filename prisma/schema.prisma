generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Campaign {
  id             String   @id
  name           String
  objective      String?
  status         String
  dailyBudget    Float?
  lifetimeBudget Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  adSets   AdSet[]
  insights Insight[]
}

model AdSet {
  id          String   @id
  campaignId  String
  name        String
  status      String
  dailyBudget Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaign Campaign  @relation(fields: [campaignId], references: [id])
  ads      Ad[]
  insights Insight[]
}

model Ad {
  id                   String   @id
  adSetId              String
  name                 String
  status               String
  creativeThumbnailUrl String?
  creativeTitle        String?
  creativeBody         String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  adSet    AdSet     @relation(fields: [adSetId], references: [id])
  insights Insight[]
}

model Insight {
  id          String   @id
  date        DateTime
  level       String
  campaignId  String?
  adSetId     String?
  adId        String?
  spend       Float    @default(0)
  impressions Int      @default(0)
  reach       Int      @default(0)
  frequency   Float    @default(0)
  clicks      Int      @default(0)
  ctr         Float    @default(0)
  cpc         Float    @default(0)
  cpm         Float    @default(0)
  leads       Int      @default(0)
  cpl         Float?
  videoPlays      Int?
  videoAvgWatchSec Float?
  videoP25    Int?
  videoP50    Int?
  videoP75    Int?
  videoP100   Int?
  thruPlays   Int?
  placement   String?
  ageGender   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaign Campaign? @relation(fields: [campaignId], references: [id])
  adSet    AdSet?    @relation(fields: [adSetId], references: [id])
  ad       Ad?       @relation(fields: [adId], references: [id])

  @@index([level, date])
  @@index([campaignId, level, date])
  @@index([adSetId, level, date])
  @@index([adId, level, date])
}

model DailyAccountSummary {
  date        DateTime @id
  spend       Float    @default(0)
  impressions Int      @default(0)
  reach       Int      @default(0)
  clicks      Int      @default(0)
  ctr         Float    @default(0)
  cpc         Float    @default(0)
  cpm         Float    @default(0)
  leads       Int      @default(0)
  cpl         Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Alert {
  id        String   @id @default(cuid())
  severity  String
  title     String
  body      String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SyncLog {
  id        String   @id @default(cuid())
  status    String
  message   String
  createdAt DateTime @default(now())
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         String   @default("viewer") // "admin" | "viewer"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ── Google Ads (kept separate from Meta tables so Meta totals are unaffected) ──

model GoogleCampaign {
  id                  String   @id // Google campaign id
  name                String
  status              String // ENABLED | PAUSED | REMOVED
  channelType         String?
  biddingStrategyType String?
  dailyBudget         Float?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  insights GoogleInsight[]
}

model GoogleInsight {
  id                    String   @id // campaignId_date
  campaignId            String
  date                  DateTime
  spend                 Float    @default(0)
  impressions           Int      @default(0)
  clicks                Int      @default(0)
  ctr                   Float    @default(0)
  cpc                   Float    @default(0)
  cpm                   Float    @default(0)
  conversions           Float    @default(0)
  conversionValue       Float    @default(0)
  costPerConversion     Float?
  allConversions        Float    @default(0)
  interactions          Int      @default(0)
  videoViews            Int      @default(0)
  searchImpressionShare Float?
  searchBudgetLostIS    Float?
  searchRankLostIS      Float?
  searchTopIS           Float?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  campaign GoogleCampaign @relation(fields: [campaignId], references: [id])

  @@index([campaignId, date])
  @@index([date])
}

model GoogleAdGroup {
  id         String   @id
  campaignId String
  name       String
  status     String
  type       String?
  cpcBid     Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([campaignId])
}

model GoogleAd {
  id           String   @id
  adGroupId    String
  campaignId   String
  name         String?
  type         String?
  status       String
  finalUrls    String[]
  headlines    String[]
  descriptions String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([adGroupId])
  @@index([campaignId])
}

model GoogleKeyword {
  id           String   @id // adGroupId~criterionId
  adGroupId    String
  campaignId   String
  text         String
  matchType    String
  status       String
  negative     Boolean  @default(false)
  qualityScore Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([campaignId])
  @@index([adGroupId])
}

// One flat fact table for every breakdown: level = ad_group | ad | keyword | search_term |
// device | network | hour | geo | age | gender | conversion_action
model GoogleStat {
  id              String   @id
  level           String
  date            DateTime
  campaignId      String
  adGroupId       String?
  entityId        String?
  dim1            String?
  dim2            String?
  spend           Float    @default(0)
  impressions     Int      @default(0)
  clicks          Int      @default(0)
  conversions     Float    @default(0)
  conversionValue Float    @default(0)
  allConversions  Float    @default(0)
  interactions    Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([level, date])
  @@index([level, campaignId, date])
}
